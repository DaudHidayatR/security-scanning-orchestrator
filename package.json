{
  "name": "security-scanning-orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Workers security scanning pipeline with AI-powered auto-remediation",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "d1:migrate:local": "wrangler d1 migrations apply security-findings --local",
    "d1:migrate": "wrangler d1 migrations apply security-findings",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "check:env": "bash scripts/check-env.sh"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250410.0",
    "typescript": "^5.8.3",
    "wrangler": "^4.12.0"
  },
  "engines": {
    "node": ">=20"
  }
}
