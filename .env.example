# Cloudflare
CF_ACCOUNT_ID=your_account_id_here
CF_AI_API_TOKEN=your_workers_ai_token_here

# GitHub App
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
GITHUB_APP_INSTALLATION_ID=98765432

# Sandbox
SANDBOX_JWT_SECRET=your_sandbox_secret_here

# --- AI Models (Cloudflare Workers AI) ---
# Default model for all tasks
AI_MODEL_DEFAULT=@cf/meta/llama-3.1-8b-instruct-fp8-fast
# Premium model for critical/high severity findings (optional)
AI_MODEL_PREMIUM=@cf/qwen/qwen2.5-coder-32b-instruct

# --- Alerts (choose one or configure both) ---

# Telegram (get from @BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_ID=-1001234567890

# Email via SendGrid
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=SG.xxxxx
EMAIL_FROM=alerts@yourdomain.com
EMAIL_TO=youremail@example.com

# Alert severity threshold (default: medium)
# Only findings at or above this severity trigger Telegram/Email alerts
ALERT_MIN_SEVERITY=medium   # options: critical, high, medium, low, info

# Email via Mailgun (alternative to SendGrid)
# EMAIL_PROVIDER=mailgun
# MAILGUN_API_KEY=key-xxxxxxxx
# MAILGUN_DOMAIN=mg.yourdomain.com
# EMAIL_FROM=alerts@mg.yourdomain.com
# EMAIL_TO=youremail@example.com
